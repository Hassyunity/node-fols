<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Developer Journey - IA</title>
  <style>
    .tree {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  text-align: left;
  padding-left: 0;
  margin: 0 auto;
}

.tree ul {
  list-style-type: none;
  position: relative;
  padding-left: 20px;
  margin: 0;
}

.tree ul::before {
  content: '';
  position: absolute;
  top: 0;
  left: 10px;
  border-left: 1px solid #ccc;
  bottom: 0;
}

.tree li {
  margin: 0;
  padding: 10px 0 0 20px;
  position: relative;
}

.tree li::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  border-top: 1px solid #ccc;
  width: 10px;
  height: 20px;
}

.tree li a {
  border: 1px solid #ccc;
  padding: 5px 10px;
  text-decoration: none;
  color: #666;
  font-size: 12px;
  border-radius: 5px;
  background: #f9f9f9;
  white-space: nowrap;
  display: inline-block;
  transition: all 0.3s ease;
}

.tree li a:hover {
  background: #00d6b4;
  color: #000;
  border: 1px solid #94a0b4;
}

/* Animation légère conservée */
@keyframes bounce-vertical {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

.tree li a[data-tech] {
  animation: bounce-vertical 2s ease-in-out infinite;
}

  </style>
</head>
