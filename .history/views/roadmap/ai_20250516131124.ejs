<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Developer Journey - Machine Learning</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    .tree a[data-tech] {
      background-color: #ffc107;
      color: black;
      cursor: pointer;
      text-decoration: none;
      padding: 5px 10px;
      border-radius: 5px;
      display: inline-block;
      margin: 2px 0;
      transition: transform 0.3s ease, background-color 0.3s;
    }

    .tree a[data-tech]:hover {
      animation: heartbeat 0.8s ease;
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      25% { transform: scale(1.05); }
      50% { transform: scale(0.97); }
      75% { transform: scale(1.03); }
    }

    #tech-panel {
      position: fixed;
      top: 0;
      right: -100%;
      width: 60%;
      height: 100%;
      background-color: white;
      box-shadow: -4px 0 12px rgba(0, 0, 0, 0.2);
      transition: right 0.4s ease;
      z-index: 1000;
      padding: 20px;
      overflow-y: auto;
    }

    #tech-panel.open {
      right: 0;
    }

    #tech-panel h2 {
      margin-top: 0;
    }

    #tech-panel .close-btn {
      position: absolute;
      top: 10px;
      right: 15px;
      font-size: 24px;
      background: none;
      border: none;
      cursor: pointer;
      color: #333;
    }
  </style>
  <link rel="stylesheet" href="/stylesheets/graph.css" />
  <link rel="stylesheet" href="/stylesheets/tech-description.css" />
</head>
<body>
  <header class="navbar">
    <%- include('../partials/navbar') %>
  </header>

  <section class="content" id="contact">
    <div class="contour">
      <p><span class="titretexte1">Machine Learning Roadmap :</span></p>
      <div class="tree">
        <ul>
          <li><a href="#">Machine Learning</a>
            <ul>
              <li><a href="#">Concepts de base</a>
                <ul>
                  <li><a href="#" data-tech="supervised">Apprentissage supervisé</a></li>
                  <li><a href="#" data-tech="unsupervised">Apprentissage non-supervisé</a></li>
                  <li><a href="#" data-tech="overfitting">Overfitting</a></li>
                  <li><a href="#" data-tech="cross_validation">Validation croisée</a></li>
                </ul>
              </li>
              <li><a href="#">Modèles populaires</a>
                <ul>
                  <li><a href="#" data-tech="decision_tree">Arbre de décision</a></li>
                  <li><a href="#" data-tech="svm">SVM</a></li>
                  <li><a href="#" data-tech="knn">K-NN</a></li>
                </ul>
              </li>
            </ul>
          </li>
        </ul>
      </div>

      <div id="tech-panel">
        <button class="close-btn" onclick="closePanel()">×</button>
        <h2 id="tech-title">Titre</h2>
        <p id="tech-text">Texte de description...</p>
        <div id="tech-iframe"></div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </section>

  <script>
    const descriptions = {
      supervised: {
        title: "Apprentissage supervisé",
        text: "Méthode où les données d’entrée sont accompagnées de sorties connues. Le modèle apprend à faire correspondre les deux.",
        iframe: `<iframe src="https://www.youtube.com/embed/GwIo3gDZCVQ" allowfullscreen></iframe>`
      },
      unsupervised: {
        title: "Apprentissage non-supervisé",
        text: "Le modèle trouve des structures ou des regroupements dans les données sans sortie connue.",
        iframe: `<iframe src="https://www.youtube.com/embed/t1ITL3qRP_o" allowfullscreen></iframe>`
      },
      overfitting: {
        title: "Overfitting",
        text: "Un modèle est en overfitting lorsqu’il est trop bien ajusté aux données d’entraînement, mais échoue sur de nouvelles données.",
        iframe: `<iframe src="https://www.youtube.com/embed/EuBBz3bI-aA" allowfullscreen></iframe>`
      },
      cross_validation: {
        title: "Validation croisée",
        text: "Technique d’évaluation d’un modèle en divisant les données en plusieurs ensembles d’entraînement/test.",
        iframe: `<iframe src="https://www.youtube.com/embed/6dbrR-WymjI" allowfullscreen></iframe>`
      },
      decision_tree: {
        title: "Arbre de décision",
        text: "Un modèle basé sur une série de décisions conditionnelles représentées sous forme d’arbre.",
        iframe: `<iframe src="https://www.youtube.com/embed/_L39rN6gz7Y" allowfullscreen></iframe>`
      },
      svm: {
        title: "SVM",
        text: "Support Vector Machine est un algorithme de classification qui maximise la marge entre les classes.",
        iframe: `<iframe src="https://www.youtube.com/embed/efR1C6CvhmE" allowfullscreen></iframe>`
      },
      knn: {
        title: "K-NN",
        text: "K-Nearest Neighbors classe une entrée selon les classes des K voisins les plus proches.",
        iframe: `<iframe src="https://www.youtube.com/embed/HVLr_pL0WZ8" allowfullscreen></iframe>`
      }
    };

    function closePanel() {
      document.getElementById("tech-panel").classList.remove("open");
    }

    document.querySelectorAll('[data-tech]').forEach(el => {
      el.addEventListener('click', event => {
        event.preventDefault();
        const key = el.dataset.tech.trim();
        const content = descriptions[key];

        if (content) {
          document.getElementById('tech-title').textContent = content.title;
          document.getElementById('tech-text').textContent = content.text;
          document.getElementById('tech-iframe').innerHTML = content.iframe;
          document.getElementById('tech-panel').classList.add('open');
        }
      });
    });
  </script>
</body>
</html>
