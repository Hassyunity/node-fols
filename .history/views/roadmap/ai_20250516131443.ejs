<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Developer Journey - IA</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    .tree a[data-tech] {
      background-color: #00d6b4;
      color: black;
      cursor: pointer;
      text-decoration: none;
      padding: 5px 10px;
      border-radius: 5px;
      display: inline-block;
      margin: 2px 0;
      transition: transform 0.3s ease, background-color 0.3s;
    }

    .tree a[data-tech]:hover {
      animation: heartbeat 0.8s ease;
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      25% { transform: scale(1.05); }
      50% { transform: scale(0.97); }
      75% { transform: scale(1.03); }
    }

    #tech-panel {
      position: fixed;
      top: 0;
      right: -100%;
      width: 60%;
      height: 100%;
      background-color: white;
      box-shadow: -4px 0 12px rgba(0, 0, 0, 0.2);
      transition: right 0.4s ease;
      z-index: 1000;
      padding: 20px;
      overflow-y: auto;
    }

    #tech-panel.open {
      right: 0;
    }

    #tech-panel h2 {
      margin-top: 0;
    }

    #tech-panel .close-btn {
      position: absolute;
      top: 10px;
      right: 15px;
      font-size: 24px;
      background: none;
      border: none;
      cursor: pointer;
      color: #333;
    }
  </style>
  <link rel="stylesheet" href="/stylesheets/graph.css" />
    <link rel="stylesheet" href="/stylesheets/tech-description.css" />
</head>
<body>
  <header class="navbar">
    <%- include('../partials/navbar') %>
  </header>

  <section class="content" id="contact">
    <div class="contour">
      <p><span class="titretexte1">AI Roadmap :</span></p>
      <div class="tree">
        <ul>
          <li><a href="#">AI</a>
            <ul>
              <li><a href="#">Common Terminology</a>
                <ul>
                  <li><a href="#" data-tech="ai_vs_agi">AI vs AGI</a></li>
                  <li><a href="#" data-tech="llms">LLMs</a></li>
                  <li><a href="#" data-tech="inference">Inference</a></li>
                  <li><a href="#" data-tech="Embeddings">Embeddings</a></li>
                  <li><a href="#" data-tech="ai_agent">AI Agent</a></li>
                  <li><a href="#" data-tech="rag">RAG</a></li>
                </ul>
              </li>
              <li><a href="#">Pre-training</a>
                <ul>
                  <li><a href="#" data-tech="claude">Claude</a></li>
                  <li><a href="#" data-tech="gemini">Gemini</a></li>
                  <li><a href="#" data-tech="azure">Azure</a></li>
                  <li><a href="#" data-tech="mistral">Mistral</a></li>
                </ul>
              </li>
              <li><a href="#">OpenAI API</a>
                <ul>
                  <li><a href="#" data-tech="api">Completion API</a></li>
                  <li><a href="#" data-tech="writing_prompt">Writing Prompt</a></li>
                  <li><a href="#" data-tech="fine">Fine-tuning</a></li>
                </ul>
              </li>
              <li><a href="#">AI Safety</a>
                <ul>
                  <li><a href="#" data-tech="prompt">Prompt Injection Attack</a></li>
                  <li><a href="#" data-tech="security">Security</a></li>
                  <li><a href="#" data-tech="bias">Bias & Fairness</a></li>
                </ul>
              </li>
            </ul>
          </li>
        </ul>
      </div>

      <!-- Panel pour les infos techniques -->
      <div id="tech-panel">
        <button class="close-btn" onclick="closePanel()">×</button>
        <h2 id="tech-title">Titre</h2>
        <p id="tech-text">Texte de description...</p>
        <div id="tech-iframe"></div>
      </div>

    </div>
    <%- include('../partials/footer') %>
  </section>

