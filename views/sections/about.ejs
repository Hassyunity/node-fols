<div class="about-section">
  <h2><%= lang === 'fr' ? "Hola ! 👋 C'est Hassy Tsihoarana" : "Hola! 👋 I'm Hassy Tsihoarana" %></h2>

  <a href="/?lang=<%= lang %>" class="avatar-back">
    <div class="avatar-ring-small">
      <img src="/images/za.png" class="avatar-small">
    </div>
  </a>

  <div class="about-hexagons">

    <!-- Rôle -->
    <div class="hex-container">
      <div class="hex about-hex web">
        <img src="/images/icons/role-model.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'Rôle' : 'Role' %></span>
      </div>
      <p class="hex-description"><%= lang === 'fr' ? 'Développeur Full-Stack' : 'Full-Stack Developer' %></p>
    </div>

    <!-- Expérience pro -->
    <div class="hex-container">
      <div class="hex about-hex db">
        <img src="/images/icons/sword.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'Expérience Pro' : 'Professional Experience' %></span>
      </div>
      <p class="hex-description"><%= lang === 'fr' ? '3 ans chez Ingedata' : '3 years at Ingedata' %></p>
    </div>

    <!-- Développement Web -->
    <div class="hex-container">
      <div class="hex about-hex web">
        <img src="/images/icons/competence.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'Développement Web' : 'Web Development' %></span>
      </div>
      <p class="hex-description">Ruby on Rails, React, Node.js, Javascript, Testing</p>
    </div>

    <!-- Bases de données -->
    <div class="hex-container">
      <div class="hex about-hex db">
        <img src="/images/icons/database.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'Bases de données' : 'Databases' %></span>
      </div>
      <p class="hex-description">PostgreSQL, MySQL</p>
    </div>

    <!-- IA & Data -->
    <div class="hex-container">
      <div class="hex about-hex ai">
        <img src="/images/icons/ai.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'IA & Data' : 'AI & Data' %></span>
      </div>
      <p class="hex-description">NLP</p>
    </div>

    <!-- DevOps / Outils -->
    <div class="hex-container">
      <div class="hex about-hex devops">
        <img src="/images/icons/agile.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'DevOps / Outils' : 'DevOps / Tools' %></span>
      </div>
      <p class="hex-description">Docker, Git, CI/CD, Render</p>
    </div>

    <!-- Méthodologies -->
    <div class="hex-container">
      <div class="hex about-hex method">
        <img src="/images/icons/metho.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'Méthodologies' : 'Methodologies' %></span>
      </div>
      <p class="hex-description">Agile, Scrum, TDD, Clean Code</p>
    </div>

    <!-- Diplôme -->
    <div class="hex-container">
      <div class="hex about-hex diploma">
        <img src="/images/icons/graduation.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'Diplôme' : 'Degree' %></span>
        <div class="stars">
          <span>★</span><span>★</span><span>★</span>
        </div>
      </div>
      <p class="hex-description"><%= lang === 'fr' ? "Licence en Développement informatique de l'ESTI" : "Bachelor's in Computer Development from ESTI" %></p>
    </div>

    <!-- Evolution -->
    <div class="hex-container">
      <div class="hex about-hex evolution">
        <img src="/images/icons/present.png" class="hex-icon">
        <span><%= lang === 'fr' ? 'Evolution' : 'Growth' %></span>
      </div>
      <p class="hex-description"><%= lang === 'fr' ? 'Web & Mobile, Déploiement sécurisé, IA' : 'Web & Mobile, Secure Deployment, AI' %></p>
    </div>

  </div>
</div>
