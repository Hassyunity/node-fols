<div class="contact-section">

  <h2>Contactez-moi !</h2>

  <a href="/" class="avatar-back">
    <div class="avatar-ring-small">
      <img src="/images/za.png" class="avatar-small">
    </div>
  </a>

  <p>Reach out! Let's start something together.</p>

  <% if(messageStatus === 'success'){ %>
    <p style="color:#38ff7a;font-weight:bold;margin-bottom:15px;">
      ✅ Votre message a été envoyé avec succès !
    </p>
  <% } else if(messageStatus === 'error'){ %>
    <p style="color:#ff4f4f;font-weight:bold;margin-bottom:15px;">
      ❌ Une erreur est survenue, veuillez réessayer.
    </p>
  <% } %>

  <form action="/submit-contact" method="POST" class="contact-form">
    <div class="row">
      <input type="text" id="name" name="name" placeholder="Entrez votre nom" required>
      <input type="email" id="email" name="email" placeholder="Entrez votre email" required>
    </div>

    <label for="message">Message :</label>
    <textarea id="message" name="message" placeholder="Entrez votre message" rows="5" required></textarea>

    <button type="submit" class="send-btn">Envoyer le message</button>
  </form>

</div>
