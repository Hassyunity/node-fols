<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/works_options.css' />
    <link rel="icon" href="/images/lg.png" type="image/x-icon">
  </head>

  <body>
    <% if (message === 'success') { %>
      <div class="success-message" id="success-message">✅ Votre message a été envoyé avec succès !</div>
    <% } %>
    <% if (message === 'error') { %>
      <div class="error-message" id="error-message">❌ Une erreur est survenue lors de l'envoi du message.</div>
    <% } %>
    <header class="navbar">
      <%- include('partials/navbar') %>
    </header>
    <section class="hero">
      <div class="hero-content">
        <h1>
          Full of ideas? Grab a
          <span class="coffee">
            <img src="images/coffe.gif" alt="Coffee cup" style="height: 1em; vertical-align: middle;">
          </span>
          — we’ll take care of the rest.
        </h1>
        <a href="/contact" class="contact">Contact me</a>
      </div>
    </section>

    <section class="content">
      <div>
        <div class="latest-work-header">
          <h2>Latest work:</h2>
          <div class="work-toggle">
            <button id="btn-personal" class="toggle-button active">Personal</button>
            <button id="btn-professional" class="toggle-button">Professional</button>
          </div>
        </div>
        <div id="works-personal">
          <%- include('partials/works') %>
        </div>

        <div id="works-professional" style="display: none;">
          <%- include('partials/works_pro') %>
        </div>

      </div>
    </section>

    <section class="content">
      <div>
        <%- include('partials/competence') %>
      </div>
      <%- include('partials/footer') %>
    </section>

    <script src="javascripts/index.js"></script>
    <script src="javascripts/notifications.js"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y7S5T9K5HT"></script>
    <script src="javascripts/grag.js"></script>
  </body>
</html>
