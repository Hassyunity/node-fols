<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Portfolio</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/stylesheets/game_portfolio.css">

  <% if (section === "about") { %>
    <link rel="stylesheet" href="/stylesheets/about.css">
  <% } %>
  <% if (section === "ruby") { %>
    <link rel="stylesheet" href="/stylesheets/ruby.css">
  <% } %>
  <% if (section === "contact") { %>
    <link rel="stylesheet" href="/stylesheets/contact.css">
  <% } %>
  <% if (section === "services") { %>
    <link rel="stylesheet" href="/stylesheets/services.css">
  <% } %>
  <% if (section === "react") { %>
    <link rel="stylesheet" href="/stylesheets/ruby.css">
  <% } %>
  <% if (section === "nodejs") { %>
    <link rel="stylesheet" href="/stylesheets/ruby.css">
  <% } %>
</head>
<body>

<header class="top-bar">
  <div class="top-left">
    <img src="/images/icons/logo.png" class="logo">
    <div class="site-date">Update: 02 Dec 2025</div>
  </div>

  <div class="top-center">
    <p class="contact-info">📞 +261 34 16 020 73</p>
    <a href="https://github.com/Hassyunity" target="_blank">
      <img src="/images/icons/github.png" class="header-icon">
    </a>
    <a href="https://www.linkedin.com/in/tsihoarana-hassy-b8349020b/" target="_blank">
      <img src="/images/icons/linkedin.png" class="header-icon">
    </a>
    <a href="https://codepen.io/hassycode" target="_blank">
      <img src="/images/icons/codepen.png" class="header-icon">
    </a>
    <a href="/files/Hassy_cv.pdf" download>
      <img src="/images/icons/cv.png" class="header-icon">
    </a>
  </div>

  <div class="top-right">
    <div class="coins-box">
      <span class="coin-icon">🌟</span>
      <span class="coins">70</span>
    </div>
  </div>
</header>

<main class="screen">

  <!-- Side left hexagons -->
  <div class="side-left">
    <a href="/ruby"><div class="hex green <% if(section==='ruby'){%>active<% } %>"><img src="/images/logos/ruby.png" class="hex-icon"><span>Ruby</span></div></a>
    <a href="/react"><div class="hex green <% if(section==='react'){%>active<% } %>"><img src="/images/logos/atom.png" class="hex-icon"><span>React</span></div></a>
    <a href="/nodejs"><div class="hex yellow <% if(section==='nodejs'){%>active<% } %>"><img src="/images/logos/node-js.png" class="hex-icon"><span>Node.js</span></div></a>
  </div>

  <!-- Center -->
  <div class="center">

    <% if (section === "home") { %>
      <div class="avatar-ring">
          <img src="/images/za.png" class="avatar">
      </div>

      <h2 class="name">Hassy Tsihoarana</h2>
      <h3 class="subtitle">Code Vibes</h3>

      <div class="role-tag">Développeur Full-Stack</div>

      <div class="projects-section">
        <h3 class="projects-title deploi">Projets déployés</h3>
        <div class="projects-stats">
            <div class="project-item render">🗄️ Render: 7</div>
            <div class="project-item netlify">⚡ Netlify: 4</div>
            <div class="project-item db">🛢️ PostgreSQL: 1</div>
        </div>
      </div>

      <button class="launch-btn">Launch Project</button>
  <% } %>

    <% if(section === "about") { %>
      <%- include("sections/about") %>
    <% } %>

    <% if(section === "contact") { %>
      <%- include("sections/contact", { messageStatus: messageStatus }) %>
    <% } %>

    <% if(section === "services") { %>
      <%- include("sections/services") %>
    <% } %>

    <% if(section === "ruby") { %>
      <%- include("sections/ruby") %>
    <% } %>

    <% if(section === "react") { %>
      <%- include("sections/react") %>
    <% } %>

    <% if(section === "nodejs") { %>
      <%- include("sections/node") %>
    <% } %>

    <% if(section === "coming") { %>
      <%- include("sections/coming") %>
    <% } %>

  </div>

  <!-- Side right hexagons -->
  <div class="side-right">
    <a href="/about"><div class="hex green <% if(section==='about'){%>active<% } %>"><img src="/images/logos/person.png" class="hex-icon"><span>À Propos</span></div></a>
    <a href="/contact"><div class="hex green <% if(section==='contact'){%>active<% } %>"><img src="/images/logos/contact-us.png" class="hex-icon"><span>Contact</span></div></a>
    <a href="/services"><div class="hex red <% if(section==='services'){%>active<% } %>"><img src="/images/logos/customer-service.png" class="hex-icon"><span>Services</span></div></a>
  </div>

</main>

</body>
</html>
